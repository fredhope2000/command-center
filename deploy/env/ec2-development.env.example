APP_NAME=Command Center
APP_ENV=development
DATABASE_URL=sqlite:////var/lib/command-center/dev.sqlite
COMMAND_CENTER_AUTH_ENABLED=true
COMMAND_CENTER_PASSWORD_HASH='$2b$12$replace-with-generated-bcrypt-hash'
COMMAND_CENTER_AUTH_SECRET=replace-with-long-random-secret
